<UserControl x:Class="gui.View.GamePhases.ResourceRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Image Source="{Binding ArrowSource}" Grid.Column="0"
               MaxHeight="{DynamicResource PhaseImageHeight}"
               Stretch="Uniform" VerticalAlignment="Center" />
        <Image Source="{Binding IconSource}" Grid.Column="1"
               MaxHeight="{DynamicResource PhaseImageHeight}"
               Stretch="Uniform" VerticalAlignment="Center"/>
        <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="DownOnly">
            <TextBlock Text="{Binding Quantity}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="{DynamicResource FontSizeMedium}"/>
        </Viewbox>
        <Button Command="{Binding DecreaseCommand}" Grid.Column="3"
                Height="{DynamicResource PhaseImageHeight}"
                MinWidth="120"
                VerticalAlignment="Center"
                Margin="8,0"
                Padding="0">
            <TextBlock Text="-1" Margin="0" FontSize="{DynamicResource FontSizeDefault}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
        <Button Command="{Binding IncreaseCommand}" Grid.Column="4"
                Height="{DynamicResource PhaseImageHeight}"
                MinWidth="120"
                VerticalAlignment="Center"
                Margin="8,0"
                Padding="0">
            <TextBlock Text="+1" Margin="0" FontSize="{DynamicResource FontSizeDefault}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
    </Grid>
</UserControl>
