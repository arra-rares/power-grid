<UserControl x:Class="gui.View.GamePhases.BuildingPhaseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:gui.ViewModel.GamePhases">

    <UserControl.DataContext>
        <vm:BuildingPhaseViewModel/>
    </UserControl.DataContext>

    <Border Margin="5">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Current:" Grid.Row="0"
                       FontSize="{DynamicResource FontSizeMedium}"
                       FontWeight="Bold" HorizontalAlignment="Left"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Source="{Binding CurrentIcon}" Grid.Column="0"
                       MaxHeight="{DynamicResource PhaseImageHeight}"
                       Stretch="Uniform" HorizontalAlignment="Center"/>
                <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly">
                    <TextBlock Text="{Binding CurrentValue}"
                               FontSize="{DynamicResource FontSizeMedium}"
                               HorizontalAlignment="Center"/>
                </Viewbox>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="+1" Command="{Binding IncreaseCurrentCommand}" Grid.Column="0"/>
                <Button Content="-1" Command="{Binding DecreaseCurrentCommand}" Grid.Column="1"/>
            </Grid>

            <TextBlock Text="Total:" Grid.Row="3"
                       FontSize="{DynamicResource FontSizeMedium}"
                       FontWeight="Bold" HorizontalAlignment="Left"/>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Image Source="{Binding TotalIcon}" Grid.Column="0"
                       MaxHeight="{DynamicResource PhaseImageHeight}"
                       Stretch="Uniform" HorizontalAlignment="Center"/>
                <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly">
                    <TextBlock Text="{Binding TotalValue}"
                               FontSize="{DynamicResource FontSizeMedium}"
                               HorizontalAlignment="Center"/>
                </Viewbox>
            </Grid>

            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="Ready" Command="{Binding ReadyCommand}" Grid.Column="0"/>
                <Button Content="Done" Command="{Binding DoneCommand}" Grid.Column="1"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
