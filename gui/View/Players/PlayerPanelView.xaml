<UserControl x:Class="gui.View.Players.PlayerPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:view="clr-namespace:gui.View.Players"
             AllowDrop="True"
             PreviewMouseLeftButtonDown="OnMouseLeftButtonDown"
             PreviewMouseMove="OnMouseMove"
             DragOver="OnDragOver"
             Drop="OnDrop">

    <UserControl.InputBindings>
        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DoubleClickCommand}" />
    </UserControl.InputBindings>

    <Border CornerRadius="10" Margin="6" Background="{StaticResource SecondaryBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" />
                <!-- StatusBtnView -->
                <ColumnDefinition Width="10*" />
                <!-- Name TextBlock -->
                <ColumnDefinition Width="8*" />
                <!-- ClockView -->
            </Grid.ColumnDefinitions>

            <view:StatusBtnView VerticalAlignment="Stretch"
                                HorizontalAlignment="Stretch" 
                                Grid.Column="0" />

            <!-- Viewbox keeps long names / large fonts inside the shared row height. -->
            <Viewbox Grid.Column="1"
                     Stretch="Uniform"
                     StretchDirection="DownOnly"
                     Margin="4">
                <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="{DynamicResource FontSizeMedium}" 
                           Foreground="White"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="400" />
            </Viewbox>

            <view:ClockView DataContext="{Binding Clock}" Grid.Column="2"/>
        </Grid>
    </Border>
</UserControl>
