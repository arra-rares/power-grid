<UserControl x:Class="gui.View.Players.ClockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="4">
            <Button Command="{Binding ButtonCommand}" Content="{Binding TimePassed}" />
        </Viewbox>
    </Grid>
</UserControl>
