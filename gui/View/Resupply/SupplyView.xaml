<UserControl x:Class="gui.View.Resupply.SupplyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Margin="4">
        <Grid Background="{StaticResource SecondaryBrush}" Margin="2">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="2">
                <TextBlock Text="{Binding SupplyValue}" Style="{Binding TextBlockStyle}"/>
            </Viewbox>
        </Grid>
    </Border>

</UserControl>
